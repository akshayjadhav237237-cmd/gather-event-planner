  "repository": {
    "type": "git",
    "url": "https://github.com/akshayjadhav237237-cmd/gather-event-planner.git"
  },
  "description": "GenAI-powered planning assistant organizing weddings, birthdays, and community events with budgets, timelines, vendor checklists, and personalized ideas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
